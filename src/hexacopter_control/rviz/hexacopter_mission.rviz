Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 120; 120; 120
      Offset: {X: 0, Y: 0, Z: 0}
      Line Style: {Line Width: 0.03, Value: Lines}
      Normal Cell Count: 0
      Plane: XY
      Reference Frame: <Fixed Frame>
      Alpha: 0.5
    - Class: rviz_default_plugins/Map
      Name: Map (raw)
      Enabled: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Use Timestamp: false
    - Class: rviz_default_plugins/Map
      Name: Map (inflated)
      Enabled: false
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_inflated
      Use Timestamp: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Victims
      Enabled: true
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /victims_markers
    - Class: rviz_default_plugins/MarkerArray
      Name: Visit order
      Enabled: true
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan/markers
    - Class: rviz_default_plugins/Path
      Name: A* plan
      Enabled: true
      Alpha: 1
      Buffer Length: 1
      Color: 255; 255; 0
      Line Style: Lines
      Line Width: 0.05
      Offset: {X: 0, Y: 0, Z: 0.02}
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan/path
    - Class: rviz_default_plugins/Path
      Name: Drone trail
      Enabled: true
      Alpha: 1
      Buffer Length: 1
      Color: 0; 200; 255
      Line Style: Lines
      Line Width: 0.03
      Offset: {X: 0, Y: 0, Z: 0.04}
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/trail
    - Class: rviz_default_plugins/Pose
      Name: Drone
      Enabled: true
      Alpha: 1
      Color: 255; 25; 0
      Head Length: 0.3
      Head Radius: 0.2
      Shaft Length: 0.6
      Shaft Radius: 0.08
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drone/pose
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/image_raw
    - Class: rviz_default_plugins/Image
      Name: Victim detections
      Enabled: false
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /debug/victims
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Scale: 40
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 8
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
