    <model name="victim_red_1"><static>true</static><pose>12.000 4.000 0.005 0 0 0</pose>
      <link name="l">
        <visual name="v"><geometry><box><size>0.4 0.4 0.01</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
      </link>
    </model>
