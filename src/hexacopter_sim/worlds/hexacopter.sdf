      <link name="l"><collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry><material><ambient>0.15 0.1 0.05 1</ambient><diffuse>0.15 0.1 0.05 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_4"><static>true</static><pose>8.000 5.000 0.35 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.4 1 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 1 0.7</size></box></geometry><material><ambient>0.15 0.1 0.05 1</ambient><diffuse>0.15 0.1 0.05 1</diffuse></material></visual>
